<UserControl x:Class="A2G.SavConverter.TeamsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:A2G.SavConverter.Localization">
    <UserControl.Resources>
        <!-- a list row: its text and a magnifying glass that opens the popup (double-click still works) -->
        <DataTemplate x:Key="TeamMagnifyRow">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" Margin="6,0,0,0"
                        ToolTip="{loc:LocalizedText 22115}" Click="MagnifyTeam_Click" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- country and global actions -->
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:LocalizedText 22116}" Margin="0,0,8,0" ToolTip="{loc:LocalizedText 22118}" Click="ExportClubInfo_Click" />
                    <Button Content="{loc:LocalizedText 22117}" Margin="0,0,8,0" ToolTip="{loc:LocalizedText 22119}" Click="ImportClubInfo_Click" />
                    <Button Content="{loc:LocalizedText 10077}" Click="ResetEdits_Click" />
                </StackPanel>
                <TextBlock Text="{loc:LocalizedText 10078}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="CountryBox" Width="260" SelectionChanged="CountryBox_SelectionChanged" />
                <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
        </Border>

        <!-- two team lists -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="LeftGroupBox" SelectionChanged="LeftGroupBox_SelectionChanged" />
                        <Button Grid.Column="1" Content="{loc:LocalizedText 22260}" ToolTip="{loc:LocalizedText 22261}" Margin="8,0,0,0" Padding="12,0" Click="SeasonResults_Click" />
                    </Grid>
                    <TextBox x:Name="LeftSearch" Grid.Row="1" Margin="0,0,0,8" TextChanged="LeftSearch_TextChanged" ToolTip="{loc:LocalizedText 22198}" Tag="{loc:LocalizedText 22198}" />
                    <ListBox x:Name="LeftList" ItemTemplate="{StaticResource TeamMagnifyRow}" Grid.Row="2" MouseDoubleClick="TeamList_DoubleClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="{loc:LocalizedText 10079}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="Swap_Click"
                        ToolTip="{loc:LocalizedText 10080}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" TextAlignment="Center"
                           Text="{loc:LocalizedText 10081}" />
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <ComboBox x:Name="RightGroupBox" Margin="0,0,0,8" SelectionChanged="RightGroupBox_SelectionChanged" />
                    <TextBox x:Name="PoolSearch" Grid.Row="1" Margin="0,0,0,8" TextChanged="PoolSearch_TextChanged" ToolTip="{loc:LocalizedText 10082}" Tag="{loc:LocalizedText 10082}" />
                    <ListBox x:Name="RightList" ItemTemplate="{StaticResource TeamMagnifyRow}" Grid.Row="2" MouseDoubleClick="TeamList_DoubleClick" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
