<UserControl x:Class="A2G.SavConverter.PlayerInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:A2G.SavConverter.Localization"
             xmlns:svc="clr-namespace:A2G.SavConverter.Services">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="250" />
            <ColumnDefinition Width="1.25*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- player list -->
        <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:LocalizedText 10073}" Style="{StaticResource SectionTitle}" />
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="{loc:LocalizedText 10074}" Tag="{loc:LocalizedText 10074}" />
                    <CheckBox x:Name="AllPlayersCheck" Margin="0,8,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed">
                        <TextBlock Text="{loc:LocalizedText 10075}" TextWrapping="Wrap" />
                    </CheckBox>
                    <Button Content="{loc:LocalizedText 22141}" ToolTip="{loc:LocalizedText 22142}" Margin="0,8,0,0" HorizontalAlignment="Left" Click="FindByPosition_Click" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
                <ListBox x:Name="PlayerList" ItemTemplate="{StaticResource TextRow}" Grid.Row="2" SelectionChanged="PlayerList_SelectionChanged" />
            </Grid>
        </Border>

        <!-- Football Manager view (dark, like the FM player report) -->
        <Border Grid.Column="1" CornerRadius="10" BorderBrush="#2B3350" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A1428" Offset="0" />
                    <GradientStop Color="#141A2E" Offset="0.22" />
                    <GradientStop Color="#0E1322" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="10">
                <StackPanel x:Name="FmPanel" Width="860" />
            </Viewbox>
        </Border>

        <!-- arrow -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="&#10132;" FontSize="38" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{loc:LocalizedText 10076}" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="11" />
        </StackPanel>

        <!-- Anstoss 2 view -->
        <Border Grid.Column="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Padding="16,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Anstoss 2 - Spielerinfo" Style="{StaticResource SectionTitle}" Margin="0" />
                </Border>
                <Viewbox x:Name="A2Host" Grid.Row="1" Stretch="Uniform" VerticalAlignment="Top" Margin="12" />
                <!-- skin and hair: the FM save has none, so the defaults are a rough rule; the user can set them per player -->
                <WrapPanel x:Name="LookPanel" Grid.Row="2" Margin="16,0,16,8">
                    <TextBlock Text="{loc:LocalizedText 22181}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{loc:LocalizedText 22182}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <svc:Stepper x:Name="SkinBox" Min="0" Max="2" Width="96" Margin="0,0,14,0" ToolTip="{loc:LocalizedText 22184}" />
                    <TextBlock Text="{loc:LocalizedText 22183}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <svc:Stepper x:Name="HairBox" Min="0" Max="5" Width="96" Margin="0,0,14,0" ToolTip="{loc:LocalizedText 22185}" />
                    <Button Content="{loc:LocalizedText 22186}" ToolTip="{loc:LocalizedText 22187}" Click="LookReset_Click" />
                </WrapPanel>
                <ScrollViewer Grid.Row="3" Height="150" VerticalScrollBarVisibility="Auto" Margin="16,0,16,12">
                    <StackPanel>
                        <!-- shown for players of the non-league clubs ("Sonstige Liga") -->
                        <Border x:Name="NonLeagueNote" Visibility="Collapsed" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{loc:LocalizedText 22188}" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                        <TextBlock x:Name="A2Notes" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
