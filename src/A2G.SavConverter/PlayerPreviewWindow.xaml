<Window x:Class="A2G.SavConverter.PlayerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:A2G.SavConverter"
        xmlns:loc="clr-namespace:A2G.SavConverter.Localization"
        Width="1240" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <!-- previous / next player of the team (only when the preview was opened from a team) -->
        <Grid x:Name="NavBar" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Width="40" Height="34" FontSize="16" ToolTip="{loc:LocalizedText 22126}" Click="Previous_Click" />
            <TextBlock x:Name="NavText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76C;" Width="40" Height="34" FontSize="16" ToolTip="{loc:LocalizedText 22127}" Click="Next_Click" />
        </Grid>
        <local:PlayerInspector x:Name="Inspector" Grid.Row="1" />
    </Grid>
</Window>
