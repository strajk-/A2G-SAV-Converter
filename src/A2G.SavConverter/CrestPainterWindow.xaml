<Window x:Class="A2G.SavConverter.CrestPainterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:A2G.SavConverter.Localization"
        Width="820" Height="640" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="230" />
        </Grid.ColumnDefinitions>

        <!-- canvas: 32 x 32 pixels, 16x zoom -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{loc:LocalizedText 22175}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Border Grid.Row="1" Width="514" Height="514" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="#FBFAF9">
                    <Grid Width="512" Height="512">
                        <Image x:Name="Canvas" Width="512" Height="512" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="Cross"
                               MouseLeftButtonDown="Canvas_Down" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up" />
                        <!-- outline of the 32 x 32 squares that can be painted (16 px each) -->
                        <Rectangle x:Name="GridOverlay" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <DrawingBrush Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Pen><Pen Brush="#80808080" Thickness="1" /></GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- tools and colours -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <RadioButton x:Name="PencilTool" GroupName="tool" IsChecked="True" Content="{loc:LocalizedText 22162}" Margin="0,0,0,6" />
                        <RadioButton x:Name="EraserTool" GroupName="tool" Content="{loc:LocalizedText 22163}" Margin="0,0,0,6" />
                        <RadioButton x:Name="FillTool" GroupName="tool" Content="{loc:LocalizedText 22164}" />
                        <RadioButton x:Name="PipetteTool" GroupName="tool" Content="{loc:LocalizedText 22165}" />
                    </UniformGrid>
                    <CheckBox x:Name="GridCheck" IsChecked="True" Content="{loc:LocalizedText 22179}" Click="GridCheck_Click" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border x:Name="CurrentColor" Width="34" Height="34" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,10,0" />
                    <Button Content="{loc:LocalizedText 22166}" Margin="0,0,6,0" Click="Undo_Click" />
                    <Button Content="{loc:LocalizedText 22167}" Click="Clear_Click" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="{loc:LocalizedText 22170}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <UniformGrid x:Name="PaletteGrid" Grid.Row="4" Columns="8" VerticalAlignment="Top" />
                <StackPanel Grid.Row="5">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{loc:LocalizedText 22168}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="Save_Click" />
                    <Button Content="{loc:LocalizedText 22064}" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
