<UserControl x:Class="A2G.SavConverter.OptionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:A2G.SavConverter.Localization"
             xmlns:svc="clr-namespace:A2G.SavConverter.Services"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:LocalizedText 10042}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:LocalizedText 10043}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="SquadSizeBox" Min="16" Max="30" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="{loc:LocalizedText 10044}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="KeepersBox" Min="1" Max="4" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="{loc:LocalizedText 10045}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="MinPlayersBox" Min="1" Max="30" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Text="{loc:LocalizedText 10046}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <svc:Stepper x:Name="TeamMinBox" Min="16" Max="30" Grid.Row="3" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:LocalizedText 21040}" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{loc:LocalizedText 21041}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{loc:LocalizedText 21042}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox0" Min="0" Max="8" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="{loc:LocalizedText 21043}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox1" Min="0" Max="8" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="{loc:LocalizedText 21044}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox2" Min="0" Max="8" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Text="{loc:LocalizedText 21045}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox3" Min="0" Max="8" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="4" Text="{loc:LocalizedText 21046}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox4" Min="0" Max="8" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="5" Text="{loc:LocalizedText 21047}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox5" Min="0" Max="8" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="6" Text="{loc:LocalizedText 21048}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox6" Min="0" Max="8" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="7" Text="{loc:LocalizedText 21049}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox7" Min="0" Max="8" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="8" Text="{loc:LocalizedText 21050}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox8" Min="0" Max="8" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="9" Text="{loc:LocalizedText 21051}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="QuotaBox9" Min="0" Max="8" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" />
                        </Grid>
                        <TextBlock x:Name="QuotaTotalText" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:LocalizedText 21053}" Margin="0,12,0,4" />
                        <ComboBox x:Name="PriorityBox" SelectionChanged="PriorityBox_SelectionChanged" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:LocalizedText 21057}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <svc:Stepper x:Name="PotentialBox" Min="0" Max="100" Step="10" Grid.Column="1" />
                        </Grid>
                        <TextBlock Text="{loc:LocalizedText 21058}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:LocalizedText 10047}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:LocalizedText 10048}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <svc:Stepper x:Name="CapBox" Min="1" Max="40" Grid.Column="1" />
                        </Grid>
                        <TextBlock Text="{loc:LocalizedText 21060}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,12,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{loc:LocalizedText 21042}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox0" Min="0" Max="8" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="{loc:LocalizedText 21043}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox1" Min="0" Max="8" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="{loc:LocalizedText 21044}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox2" Min="0" Max="8" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="3" Text="{loc:LocalizedText 21045}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox3" Min="0" Max="8" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="4" Text="{loc:LocalizedText 21046}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox4" Min="0" Max="8" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="5" Text="{loc:LocalizedText 21047}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox5" Min="0" Max="8" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="6" Text="{loc:LocalizedText 21048}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox6" Min="0" Max="8" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="7" Text="{loc:LocalizedText 21049}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox7" Min="0" Max="8" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="8" Text="{loc:LocalizedText 21050}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox8" Min="0" Max="8" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="9" Text="{loc:LocalizedText 21051}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="AvQuotaBox9" Min="0" Max="8" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8" />
                        </Grid>
                        <TextBlock x:Name="AvQuotaTotalText" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:LocalizedText 10049}" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="{loc:LocalizedText 10050}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,8"><TextBlock Text="{loc:LocalizedText 10051}" Style="{StaticResource Muted}" /><svc:Stepper x:Name="Band0" Min="1" Max="200" Step="5" /></StackPanel>
                            <StackPanel Margin="0,0,8,8"><TextBlock Text="{loc:LocalizedText 10052}" Style="{StaticResource Muted}" /><svc:Stepper x:Name="Band1" Min="1" Max="200" Step="5" /></StackPanel>
                            <StackPanel Margin="0,0,0,8"><TextBlock Text="{loc:LocalizedText 10053}" Style="{StaticResource Muted}" /><svc:Stepper x:Name="Band2" Min="1" Max="200" Step="5" /></StackPanel>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="{loc:LocalizedText 10054}" Style="{StaticResource Muted}" /><svc:Stepper x:Name="Band3" Min="1" Max="200" Step="5" /></StackPanel>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="{loc:LocalizedText 10055}" Style="{StaticResource Muted}" /><svc:Stepper x:Name="Band4" Min="1" Max="200" Step="5" /></StackPanel>
                            <StackPanel><TextBlock Text="{loc:LocalizedText 10056}" Style="{StaticResource Muted}" /><svc:Stepper x:Name="Band5" Min="1" Max="200" Step="5" /></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:LocalizedText 10057}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="{loc:LocalizedText 10058}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="SecondaryBox" Min="1" Max="20" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="{loc:LocalizedText 10059}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="0,0,0,8" />
                            <svc:Stepper x:Name="MaxPosBox" Min="1" Max="2" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="{loc:LocalizedText 10060}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <svc:Stepper x:Name="MaxNegBox" Min="0" Max="2" Grid.Row="2" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TabControl x:Name="RulesTabs">
                    <!-- ============ abilities ============ -->
                    <TabItem Header="{loc:LocalizedText 21015}">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,10"
                                       Text="{loc:LocalizedText 10062}" />
                            <DataGrid x:Name="RuleGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" IsReadOnly="True" BorderBrush="{DynamicResource LineBrush}"
                                      HorizontalGridLinesBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}" RowBackground="{DynamicResource CardBrush}" AlternatingRowBackground="{DynamicResource AltRowBrush}"
                                      SelectionMode="Single" CellEditEnding="RuleGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10063}" HeaderStyle="{StaticResource CenterHeader}" Width="48">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10064}" Width="150">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10065}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <DockPanel VerticalAlignment="Center">
                                                <Button DockPanel.Dock="Right" Content="{loc:LocalizedText 10066}" Width="92" Height="26" Padding="0" Margin="8,0,0,0" Click="EditAttributes_Click" />
                                                <TextBlock Text="{Binding AttributesText}" ToolTip="{Binding AttributesText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10067}" HeaderStyle="{StaticResource CenterHeader}" Width="108">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <ComboBox Width="84" Height="26" Padding="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" SelectedItem="{Binding Mode, Mode=TwoWay}">
                                                <ComboBox.ItemsSource>
                                                    <x:Array Type="sys:String"><sys:String>avg</sys:String><sys:String>min</sys:String><sys:String>max</sys:String></x:Array>
                                                </ComboBox.ItemsSource>
                                            </ComboBox>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10068}" HeaderStyle="{StaticResource CenterHeader}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <svc:Stepper Min="0" Max="20" Step="1" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" Value="{Binding Positive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10069}" HeaderStyle="{StaticResource CenterHeader}" Width="150">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <svc:Stepper Min="0" Max="20" Step="1" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" Value="{Binding Negative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ============ traits, characters, health ============ -->
                    <TabItem Header="{loc:LocalizedText 21016}">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,10"
                                       Text="{loc:LocalizedText 21017}" />
                            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                <svc:Stepper x:Name="MaxTraitsBox" DockPanel.Dock="Right" Min="1" Max="3" Width="112" />
                                <TextBlock Text="{loc:LocalizedText 21018}" VerticalAlignment="Center" Padding="0,0,10,0" />
                            </DockPanel>
                            <DataGrid x:Name="TraitGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34" IsReadOnly="True" BorderBrush="{DynamicResource LineBrush}"
                                      HorizontalGridLinesBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}" RowBackground="{DynamicResource CardBrush}" AlternatingRowBackground="{DynamicResource AltRowBrush}"
                                      SelectionMode="Single" CellEditEnding="RuleGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 10063}" HeaderStyle="{StaticResource CenterHeader}" Width="48">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 21019}" Width="110">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 21024}" Width="170">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 21025}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <DockPanel VerticalAlignment="Center">
                                                <Button DockPanel.Dock="Right" Content="{loc:LocalizedText 10066}" Width="92" Height="26" Padding="0" Margin="8,0,0,0" Click="EditConditions_Click" />
                                                <TextBlock Text="{Binding ConditionsText}" ToolTip="{Binding ConditionsText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:LocalizedText 21026}" HeaderStyle="{StaticResource CenterHeader}" Width="96">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <TextBlock Text="{Binding CountText}" ToolTip="{loc:LocalizedText 21027}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button Content="{loc:LocalizedText 10070}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Apply_Click" />
                    <Button Content="{loc:LocalizedText 10071}" Margin="0,0,8,0" Click="Save_Click" />
                    <Button Content="{loc:LocalizedText 10072}" Click="Reset_Click" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" Padding="0,0,6,0" VerticalAlignment="Center" Margin="14,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>