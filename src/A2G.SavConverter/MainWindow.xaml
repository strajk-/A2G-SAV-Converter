<Window x:Class="A2G.SavConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:A2G.SavConverter.Localization"
        xmlns:local="clr-namespace:A2G.SavConverter"
        xmlns:svc="clr-namespace:A2G.SavConverter.Services"
        Title="{loc:LocalizedText 10000}"
        Width="1560" Height="900" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
        <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="{loc:LocalizedText 10000}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{loc:LocalizedText 10001}" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock Text="{loc:LocalizedText 20053}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="LangBox" Width="120" Margin="0,0,18,0" SelectionChanged="LangBox_SelectionChanged" ToolTip="{loc:LocalizedText 20054}" />
            <TextBlock Text="{loc:LocalizedText 10002}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ThemeBox" Width="110" SelectionChanged="ThemeBox_SelectionChanged" ToolTip="{loc:LocalizedText 10003}" />
        </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1">

            <!-- ============ Project / export ============ -->
            <TabItem Header="{loc:LocalizedText 10004}">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="{loc:LocalizedText 10005}" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,10">
                            <ComboBox x:Name="ProjectCombo" SelectionChanged="ProjectCombo_SelectionChanged" />
                            <TextBlock x:Name="ProjectPathText" Style="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                            <Button Content="{loc:LocalizedText 28040}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="NewProject_Click" />
                            <Button Content="{loc:LocalizedText 28041}" Margin="0,0,8,0" Click="RenameProject_Click" />
                            <Button Content="{loc:LocalizedText 28042}" Margin="0,0,8,0" Click="DeleteProject_Click" />
                            <Button Content="{loc:LocalizedText 28043}" ToolTip="{loc:LocalizedText 20003}" Click="BrowseProject_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{loc:LocalizedText 10007}" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <TextBox x:Name="SaveBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" LostFocus="SaveBox_LostFocus" />
                        <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Content="{loc:LocalizedText 10008}" Margin="0,0,4,0" Click="BrowseSave_Click" />
                            <Button Grid.Column="1" Content="{loc:LocalizedText 28090}" Margin="4,0,0,0" Click="CommunitySave_Click" />
                        </Grid>
                        <TextBlock x:Name="SaveStatusText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="2,0,0,12" Style="{StaticResource Muted}" />

                        <TextBlock Grid.Row="3" Text="{loc:LocalizedText 10010}" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="A2Box" Grid.Row="3" Grid.Column="1" Margin="0,0,8,10" />
                        <Button Grid.Row="3" Grid.Column="2" Content="{loc:LocalizedText 10008}" Margin="0,0,0,10" Click="BrowseA2_Click" />

                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,12">
                            <Button x:Name="ExportButton" Content="{loc:LocalizedText 10011}" Style="{StaticResource PrimaryButton}" Click="Export_Click" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Style="{StaticResource Muted}"
                                   Text="{loc:LocalizedText 10013}" />
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============ Convert ============ -->
            <!-- ============ Options ============ -->
            <TabItem Header="{loc:LocalizedText 10014}">
                <local:OptionsTab x:Name="Options" />
            </TabItem>

            <!-- ============ Convert ============ -->
            <TabItem x:Name="PlanTabItem" Header="{loc:LocalizedText 10015}" ToolTipService.ShowOnDisabled="True">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BuildPlanButton" Content="{loc:LocalizedText 10016}" Style="{StaticResource PrimaryButton}" Margin="0,0,14,0" Click="BuildPlan_Click" />
                            <TextBlock Text="{loc:LocalizedText 10095}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900" />
                        </StackPanel>
                        <TextBox x:Name="SummaryBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============ Teams ============ -->
            <TabItem x:Name="TeamsTabItem" Header="{loc:LocalizedText 10019}" ToolTipService.ShowOnDisabled="True">
                <local:TeamsTab x:Name="TeamsEditor" />
            </TabItem>

            <!-- ============ Players ============ -->
            <TabItem x:Name="PlayersTab" Header="{loc:LocalizedText 10020}" ToolTipService.ShowOnDisabled="True">
                <local:PlayerInspector x:Name="Inspector" />
            </TabItem>

            <!-- ============ Crests ============ -->
            <TabItem x:Name="CrestsTabItem" Header="{loc:LocalizedText 22177}" ToolTipService.ShowOnDisabled="True">
                <local:CrestsTab x:Name="CrestsEditor" />
            </TabItem>

            <!-- ============ Install / profiles ============ -->
            <TabItem Header="{loc:LocalizedText 10021}">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" MinHeight="64" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" MinHeight="80" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:LocalizedText 10093}" Style="{StaticResource SectionTitle}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="WriteButton" Content="{loc:LocalizedText 10017}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Write_Click" />
                            <Button Content="{loc:LocalizedText 10018}" Margin="0,0,16,0" Click="OpenOutput_Click" />
                            <!-- the year the game starts in: like the FM save, or a year of your choice (the day and month are fixed in the game) -->
                            <CheckBox x:Name="YearAuto" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{loc:LocalizedText 22202}" Click="YearAuto_Click" />
                            <svc:Stepper x:Name="YearBox" Min="1998" Max="2098" Width="104" Margin="0,0,16,0" ToolTip="{loc:LocalizedText 22202}" />
                            <TextBlock x:Name="WriteInfoText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="WriteResultBox" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" Margin="0,0,0,14"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3" Text="{loc:LocalizedText 10094}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ProfileStatusText" Grid.Row="4" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="5" Margin="0,0,0,12">
                                <TextBlock Text="{loc:LocalizedText 10027}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="NewProfileBox" Width="180" Text="FM" Margin="0,0,10,0" />
                                <Button Content="{loc:LocalizedText 10028}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="InstallProfile_Click" />
                                <Button Content="{loc:LocalizedText 28016}" ToolTip="{loc:LocalizedText 28017}" Margin="0,0,20,0" Click="CreatePatch_Click" />
                                <CheckBox x:Name="PartialCheck" Content="{loc:LocalizedText 10029}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox x:Name="GrpNames" Content="{loc:LocalizedText 10030}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpAvereine" Content="{loc:LocalizedText 10031}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpDeu" Content="{loc:LocalizedText 10032}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpEng" Content="{loc:LocalizedText 10033}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpFra" Content="{loc:LocalizedText 10034}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpIta" Content="{loc:LocalizedText 10035}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpEsp" Content="{loc:LocalizedText 10036}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="GrpYear" Content="{loc:LocalizedText 28070}" ToolTip="{loc:LocalizedText 28071}" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                            </WrapPanel>
                        <ListView x:Name="ProfileList" Grid.Row="6" Margin="0,0,0,12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:LocalizedText 10022}" Width="220" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="{loc:LocalizedText 10023}" Width="76" DisplayMemberBinding="{Binding Live}" />
                                    <GridViewColumn Header="{loc:LocalizedText 10024}" Width="170" DisplayMemberBinding="{Binding Created}" />
                                    <GridViewColumn Header="{loc:LocalizedText 10025}" Width="90" DisplayMemberBinding="{Binding FileCount}" />
                                    <GridViewColumn Header="{loc:LocalizedText 10026}" Width="520" DisplayMemberBinding="{Binding Source}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <WrapPanel Grid.Row="7">
                                <Button Content="{loc:LocalizedText 10037}" Margin="0,0,8,0" Click="ActivateProfile_Click" />
                                <Button Content="{loc:LocalizedText 10038}" Margin="0,0,8,0" Click="RenameProfile_Click" />
                                <Button Content="{loc:LocalizedText 10039}" Margin="0,0,8,0" Click="DeleteProfile_Click" />
                                <Button Content="{loc:LocalizedText 10040}" Click="RefreshProfiles_Click" />
                            </WrapPanel>
                        
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Busy" Height="6" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Hidden" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="{loc:LocalizedText 10041}" Padding="12,4" IsEnabled="False" Click="Cancel_Click" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="2">
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
