<Window x:Class="A2G.SavConverter.CommunitySavesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:A2G.SavConverter.Localization"
        Width="720" Height="480" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{loc:LocalizedText 28091}"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:LocalizedText 28092}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,8" />

        <ListView x:Name="SaveList" Grid.Row="2" SelectionMode="Single" SelectionChanged="SaveList_SelectionChanged" MouseDoubleClick="SaveList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding Folder}" />
                    <GridViewColumn Header="" Width="290" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="" Width="140" DisplayMemberBinding="{Binding LocalText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ReloadButton" Content="{loc:LocalizedText 28104}" Margin="0,0,8,0" Click="Reload_Click" />
            <Button x:Name="SelectButton" Content="{loc:LocalizedText 28095}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="Select_Click" />
            <Button Content="{loc:LocalizedText 10041}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
